{
  "name": "striketips-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-25",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "BACKEND_API_URL": "https://gmpho--strike-tips-racing-serve-api.modal.run"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "strike-tips-racing",
    "database_id": "e28bece6-9c1a-4662-9225-b6373bbf23a6"
  }],
  "kv_namespaces": [{
    "binding": "ODDS_KV",
    "id": "3e60752804c4489c9542a6e211ea549d"
  }],
  "triggers": {
    // Hourly fallback only. The 5-minute refresh now rides on HUD traffic
    // (see src/betway-traffic.ts), which lands in the colo Betway accepts.
    // Hourly keeps KV writes under the free tier's 1,000/day cap.
    "crons": ["0 * * * *"]
  }
}
