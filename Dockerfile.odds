FROM python:3.12-slim

WORKDIR /app
RUN mkdir -p /app/data/browser_profile /app/data/cache

# 2. Dependencies — install uv, then use it (uv is 10-100x faster than pip)
RUN pip install --no-cache-dir uv -i https://pypi.tuna.tsinghua.edu.cn/simple/ --trusted-host pypi.tuna.tsinghua.edu.cn
COPY pinned-requirements.txt .
ENV UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple/
RUN uv pip install --prerelease=allow --system -r pinned-requirements.txt

# 3. Playwright system deps (libglib2.0, libnss3, etc.)
RUN playwright install-deps chromium 2>&1 || echo "System deps install failed — will retry at runtime"

# 4. Source Code Layer
COPY . .

# Persist Scrapling cache under host-mounted volume
RUN mkdir -p /app/data/.scrapling && ln -sfn /app/data/.scrapling /root/.scrapling

# Install browsers at runtime (CDN reachable from containers, not Docker build daemon)
CMD playwright install chromium 2>&1 || true && python core_agent/core/adaptive_odds_monitor.py
