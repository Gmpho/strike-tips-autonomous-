FROM python:3.12-slim

WORKDIR /app
RUN mkdir -p /app/data/cache

# 2. Dependencies — install uv, then use it (uv is 10-100x faster than pip)
# Refresh OS trust store (emSign root removal) and pin uv: <0.13.4 ships a
# vendored webpki bundle that still trusts the compromised emSign ECC Root CA - G3.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && update-ca-certificates \
 && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir "uv>=0.13.4" -i https://pypi.tuna.tsinghua.edu.cn/simple/ --trusted-host pypi.tuna.tsinghua.edu.cn
COPY pinned-requirements.txt .
ENV UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple/
# WSL2 with 6GB RAM: uv's default fan-out mmaps hundreds of wheels at once and
# the kernel drops pages mid-write -> Bus error. Throttle it; copy beats hardlink
# across the overlay.
ENV UV_CONCURRENT_DOWNLOADS=4 \
    UV_CONCURRENT_BUILDS=2 \
    UV_LINK_MODE=copy
RUN uv pip install --prerelease=allow --system -r pinned-requirements.txt

# 3. Source Code Layer
COPY . .

# No browser: the odds monitor talks to Betway's TrackRacing JSON endpoint via
# the paced policy client. Chromium/Playwright were removed Nov-2026.
CMD python core_agent/core/adaptive_odds_monitor.py
