FROM python:3.10-slim

# 1. Static Setup
WORKDIR /app
# Ensure data and browser profile dirs exist
RUN mkdir -p /app/data/browser_profile /app/data/cache

# 2. Dependency Layer
COPY requirements.txt .
RUN pip install --timeout=300 --retries=5 --default-timeout=300 -r requirements.txt beautifulsoup4 lxml aiohttp

# Install Playwright system dependencies (libglib2.0, libnss3, etc.)
RUN playwright install-deps chromium 2>&1 || echo "System deps install failed — will retry at runtime"

# 3. User config — must be root for host-mounted volume write access
USER root

# 4. Source Code Layer
COPY . .

# Persist Scrapling cache under host-mounted volume
RUN mkdir -p /app/data/.scrapling && ln -sfn /app/data/.scrapling /root/.scrapling


# Install browsers at runtime (CDN is reachable from containers but not Docker build daemon)
CMD playwright install chromium 2>&1 || true && python core_agent/core/adaptive_odds_monitor.py
